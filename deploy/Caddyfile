# Обратный прокси на сервере: HTTPS (сертификат Let's Encrypt Caddy получает сам) и раздача медиа.
# SITE_ADDRESS берётся из .env на сервере, например:
#   SITE_ADDRESS=hakaton.marshmeg.ru
#   SITE_ADDRESS=hakaton.marshmeg.ru, http://129.101.119.98   (ещё и по IP без HTTPS)
{$SITE_ADDRESS} {
	encode gzip

	# Медиа (аудио, картинки, аватарки) лежат в MinIO; анонимно можно только читать файл по прямой
	# ссылке, список файлов бакета закрыт (политика задаётся в minio-init, docker-compose.yml).
	handle /votes-media/* {
		reverse_proxy minio:9000
	}

	handle {
		reverse_proxy web:8000
	}
}
