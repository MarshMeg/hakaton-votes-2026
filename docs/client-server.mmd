flowchart TD
    Start(["Запуск приложения"]) --> HasAcc{"На телефоне уже есть<br/>аккаунт (вход выполнен)?"}

    HasAcc -- "нет, первый вход" --> Auth["Окно регистрации / входа"]
    Auth --> Req["POST /api/signup или /api/login"]
    Req --> Resp{"Ответ сервера"}
    Resp -- "ошибка: логин занят,<br/>неверный пароль" --> Auth
    Resp -- "сервер недоступен" --> Deny["Доступ запрещён:<br/>«Для первого входа нужен интернет»"]
    Deny -- "Повторить" --> Auth
    Resp -- "профиль создан /<br/>вход выполнен" --> M
    HasAcc -- "да" --> M

    subgraph Cycle["Стандартный цикл"]
        M["1. GET /bundle/manifest.json"] --> Blobs["2. Скачать изменившиеся файлы<br/>blobs/#lt;sha#gt;, проверить sha256"]
        Blobs --> Sync
        subgraph Sync["3. Синхронизация сохранения"]
            Online{"Сервер доступен?"}
            Online -- "да" --> Cmp{"Сравнить updated:<br/>локальное vs серверное"}
            Cmp -- "локальное от того же<br/>момента или новее" --> Push["PUT /api/save — отправить локальное<br/>и использовать его"]
            Cmp -- "на сервере новее" --> Pull["GET /api/save — загрузить с сервера,<br/>заменить локальное и использовать"]
            Online -- "нет" --> Local["Использовать последнее локальное"]
        end
        Push --> Home
        Pull --> Home
        Local --> Home
        Home["4. Главная страница"]
    end
    M -- "сервер недоступен:<br/>текущий снимок" --> Online

    Home --> Act["5. Конечное действие: игра или упражнение<br/>завершено, профиль изменён"]
    Act --> Save[("Локальное сохранение:<br/>профиль + прогресс, updated = сейчас")]
    Save --> Online2{"Сервер доступен?"}
    Online2 -- "да" --> Send["PUT /api/save"]
    Online2 -- "нет" --> Wait["Только локально,<br/>уйдёт на шаге 3 при следующем запуске"]
    Send --> Home
    Wait --> Home
