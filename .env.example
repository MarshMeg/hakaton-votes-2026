# Скопируйте в .env и при необходимости поменяйте значения.
# Обязателен при DJANGO_DEBUG=0. Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=*
# Публичный адрес сервера (на него смотрит Android-приложение).
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,https://hakaton.marshmeg.ru

# Админ создаётся автоматически при первом запуске (/admin).
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=admin12345
DJANGO_SUPERUSER_EMAIL=admin@example.com

POSTGRES_DB=votes
POSTGRES_USER=votes
POSTGRES_PASSWORD=votes

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_BUCKET=votes-media
# Адрес MinIO, видимый из браузера/телефона (для ссылок на аудио и картинки).
# Локально:
S3_PUBLIC_DOMAIN=localhost:9000/votes-media
S3_PUBLIC_PROTOCOL=http:
# На сервере (docker-compose.prod.yml: Caddy с HTTPS, /votes-media/ проксируется в MinIO):
# SITE_ADDRESS=hakaton.marshmeg.ru
# S3_PUBLIC_DOMAIN=hakaton.marshmeg.ru/votes-media
# S3_PUBLIC_PROTOCOL=https:
